#!/bin/sh
# Blocks pushes (including deletes and "feat:main") to protected branches.
# Protected: git config hooks.protectedBranches (space or comma separated); default "main master".
# Bypass: ALLOW_MAIN=1 git push ...  (or git push --no-verify)
# stdin: <local ref> <local sha> <remote ref> <remote sha>

# ALLOW_MAIN=1 skips only the branch guard; the secret scan, typecheck and tests still run.

protected=$(git config --get hooks.protectedBranches | tr ',' ' ')
[ -n "$protected" ] || protected="main master"

blocked=""
ranges=""   # one git-log range per line (scanned one by one)
zero=0000000000000000000000000000000000000000
nl='
'
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$_local_sha" != "$zero" ]; then
    if [ "$_remote_sha" = "$zero" ]; then ranges="$ranges$_local_sha --not --remotes$nl"
    else ranges="$ranges$_remote_sha..$_local_sha$nl"; fi
  fi
  for p in $protected; do
    if [ "$remote_ref" = "refs/heads/$p" ]; then
      blocked="$blocked $p"
    fi
  done
done

if [ -n "$blocked" ] && [ "${ALLOW_MAIN:-}" != "1" ]; then
  {
    echo "✋ Direct push to protected branch blocked:$blocked (remote: ${1:-?})"
    echo "   Create a work branch:  git switch -c feat/<name>"
    echo "   and push it:           git push -u origin feat/<name>"
    echo "   Deliberate bypass:     ALLOW_MAIN=1 git push ..."
  } >&2
  exit 1
fi

# Secret scan (hooks.secrets) on the commits being pushed: second layer after pre-commit.
if [ -n "$ranges" ]; then
  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "✋ gitleaks not found: install it so pushed commits are scanned for secrets." >&2
    exit 1
  fi
  printf '%s' "$ranges" | while IFS= read -r r; do
    [ -n "$r" ] || continue
    gitleaks git --no-banner --redact --verbose --log-level warn --exit-code 1 --log-opts="$r" >&2 || {
      echo "✋ gitleaks found a possible secret in the commits being pushed ($r)." >&2
      exit 1
    }
  done || exit 1
fi

# Quality (hooks.quality): typecheck each pushed commit (not the working tree), like 'npm run typecheck' in CI.
# Each pushed tip is checked out in a temporary worktree that reuses this clone's node_modules.
tips=$(printf '%s' "$ranges" | sed 's/ .*//; s/.*\.\.//' | sort -u)
if [ -n "$tips" ] && [ -d node_modules ]; then
  root=$(git rev-parse --show-toplevel)
  for sha in $tips; do
    # Each check depends on the pushed commit's files, not on this working tree.
    has_tsconfig=0; git cat-file -e "$sha:tsconfig.json" 2>/dev/null && has_tsconfig=1
    # Tests run only when the pushed commit's package.json declares scripts.test (npm test fails without one).
    has_package=0
    git show "$sha:package.json" 2>/dev/null | node -e 'let s="";process.stdin.on("data",(d)=>{s+=d}).on("end",()=>{try{process.exit(JSON.parse(s).scripts?.test?0:1)}catch{process.exit(1)}})' 2>/dev/null && has_package=1
    [ $has_tsconfig -eq 1 ] || [ $has_package -eq 1 ] || continue
    wt=$(mktemp -d "${TMPDIR:-/tmp}/pre-push-check.XXXXXX")
    git worktree add -q --detach "$wt" "$sha" 2>/dev/null || { rm -rf "$wt"; echo "✋ Could not check out $sha for typecheck/tests." >&2; exit 1; }
    ln -s "$root/node_modules" "$wt/node_modules"
    rc=0; step=""
    if [ $has_tsconfig -eq 1 ]; then
      ( cd "$wt" && npx --no-install tsc --noEmit ); rc=$?
      step="Typecheck (tsc --noEmit)"
    fi
    # hooks.quality: the same tests CI runs (npm test), on the pushed commit.
    if [ $rc -eq 0 ] && [ $has_package -eq 1 ]; then
      ( cd "$wt" && npm test --silent ); rc=$?
      step="Tests (npm test)"
    fi
    git worktree remove --force "$wt" >/dev/null 2>&1; rm -rf "$wt"
    [ $rc -eq 0 ] || { echo "✋ $step failed on pushed commit $sha. Fix it or: git push --no-verify" >&2; exit 1; }
  done
fi
exit 0
