#!/bin/sh
# 1. Blocks direct commits on protected branches.
#    Protected: git config hooks.protectedBranches (space or comma separated); default "main master".
#    Bypass: ALLOW_MAIN=1 git commit ...
# 2. Hygiene on staged content (check_merge_conflict, check_added_large_files):
#    blocks unresolved conflict markers and new files above git config hooks.maxFileKB (default 500; Git LFS files skipped).
# Bypass everything: git commit --no-verify
# Quality and secret-scan steps go after this block (see assets/githooks/staged.sh).

if [ "${ALLOW_MAIN:-}" != "1" ]; then
  branch=$(git symbolic-ref --short -q HEAD)  # empty on detached HEAD: allowed
  protected=$(git config --get hooks.protectedBranches | tr ',' ' ')
  [ -n "$protected" ] || protected="main master"
  for p in $protected; do
    if [ -n "$branch" ] && [ "$branch" = "$p" ]; then
      {
        echo "✋ Direct commit on protected branch '$branch' is blocked."
        echo "   Create a work branch:  git switch -c feat/<name>"
        echo "   Deliberate bypass:     ALLOW_MAIN=1 git commit ..."
      } >&2
      exit 1
    fi
  done
fi

check_merge_conflict() {
  hits=$(git diff --cached -U0 --no-color --diff-filter=ACMR | grep -nE '^\+(<{7}|>{7})( |$)' | head -5)
  [ -z "$hits" ] && return 0
  echo "✋ Unresolved merge conflict markers in staged changes:" >&2
  printf '%s\n' "$hits" | sed 's/^/   /' >&2
  return 1
}

check_added_large_files() {
  max_kb=$(git config --get hooks.maxFileKB); max_kb=${max_kb:-500}
  big=$(git diff --cached --name-only --diff-filter=A -z | xargs -0 -I{} sh -c '
    [ "$(git check-attr filter -- "$1" | sed "s/.*: //")" = lfs ] && exit 0
    kb=$(( ($(git cat-file -s ":$1") + 1023) / 1024 ))
    [ "$kb" -gt "$2" ] && echo "$1 (${kb} KB)"
    exit 0' sh {} "$max_kb")
  [ -z "$big" ] && return 0
  {
    echo "✋ New files above ${max_kb} KB (git config hooks.maxFileKB):"
    printf '%s\n' "$big" | sed 's/^/   /'
    echo "   Track them with Git LFS, or raise the limit if they belong in git."
  } >&2
  return 1
}

check_merge_conflict || exit 1
check_added_large_files || exit 1

# Quality (hooks.quality): Biome lint + format check on staged files only (fix with: npm run format).
if [ -f biome.json ] && [ -d node_modules ]; then
  . "$(dirname "$0")/staged.sh"
  run_staged 'npx --no-install biome check --no-errors-on-unmatched --files-ignore-unknown=true' \
    '*.ts' '*.tsx' '*.js' '*.mjs' '*.cjs' '*.json' || {
    echo "✋ Biome found lint/format errors in staged files. Fix with: npm run format" >&2
    exit 1
  }
fi

# 3. Secret scan (hooks.secrets): gitleaks on staged changes. Fails closed when gitleaks is missing.
#    False positive: add a "gitleaks:allow" comment on the line, or list it in .gitleaksignore.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✋ gitleaks not found: install it (e.g. 'sudo pacman -S gitleaks') so secrets are scanned." >&2
  exit 1
fi
gitleaks git --staged --no-banner --redact --verbose --log-level warn --exit-code 1 >&2 || {
  echo "✋ gitleaks found a possible secret in staged changes. Remove it (and rotate it if real)." >&2
  exit 1
}
exit 0
