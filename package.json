{
  "name": "software-factories",
  "version": "1.0.0",
  "private": true,
  "description": "Fábrica de Software: daemon que leva cards do Jira até o MR",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pr:finish": "bash scripts/pr-finish.sh",
    "test": "vitest run",
    "lint:boundaries": "depcruise src/packages"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-durable": "^1.5.0",
    "@earendil-works/pi-schema": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "lucide-static": "^1.70.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
